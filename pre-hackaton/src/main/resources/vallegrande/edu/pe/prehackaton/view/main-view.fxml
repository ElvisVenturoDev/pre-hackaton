<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="vallegrande.edu.pe.prehackaton.controller.MainController"
      styleClass="root-panel">

    <HBox styleClass="header" alignment="CENTER_LEFT" spacing="12">
        <padding>
            <Insets top="16" right="22" bottom="16" left="22"/>
        </padding>
        <Label text="Registro de Personas" styleClass="title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="MySQL · db_tarea" styleClass="badge"/>
    </HBox>

    <HBox spacing="18" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="18" right="18" bottom="18" left="18"/>
        </padding>

        <VBox spacing="8" styleClass="card" prefWidth="340" minWidth="320">
            <Label text="Datos de la persona" styleClass="card-title"/>

            <Label text="DNI *" styleClass="field-label"/>
            <TextField fx:id="txtDni" promptText="8 dígitos"/>

            <Label text="Nombres *" styleClass="field-label"/>
            <TextField fx:id="txtNombres" promptText="Nombres"/>

            <Label text="Apellidos *" styleClass="field-label"/>
            <TextField fx:id="txtApellidos" promptText="Apellidos"/>

            <Label text="Teléfono" styleClass="field-label"/>
            <TextField fx:id="txtTelefono" promptText="Hasta 9 dígitos"/>

            <Label text="Correo electrónico" styleClass="field-label"/>
            <TextField fx:id="txtCorreo" promptText="correo@ejemplo.com"/>

            <Label text="Dirección" styleClass="field-label"/>
            <TextField fx:id="txtDireccion" promptText="Dirección"/>

            <Label text="Fecha de nacimiento" styleClass="field-label"/>
            <DatePicker fx:id="dpFechaNacimiento" promptText="dd/mm/aaaa" maxWidth="Infinity"/>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnLimpiar" text="Limpiar" styleClass="btn-secondary"/>
                <Button fx:id="btnGuardar" text="Guardar" styleClass="btn-primary" defaultButton="true"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="btnActualizar" text="Actualizar" styleClass="btn-accent" disable="true"/>
                <Button fx:id="btnEliminar" text="Eliminar" styleClass="btn-danger" disable="true"/>
            </HBox>
        </VBox>

        <VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS">
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="Personas registradas" styleClass="card-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar por DNI, nombre, correo..."
                           prefWidth="280" styleClass="search"/>
            </HBox>

            <TableView fx:id="tblPersonas" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50" maxWidth="70"/>
                    <TableColumn fx:id="colDni" text="DNI" prefWidth="90"/>
                    <TableColumn fx:id="colNombres" text="Nombres" prefWidth="140"/>
                    <TableColumn fx:id="colApellidos" text="Apellidos" prefWidth="140"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="105"/>
                    <TableColumn fx:id="colCorreo" text="Correo" prefWidth="190"/>
                    <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="170"/>
                    <TableColumn fx:id="colFechaNacimiento" text="Nacimiento" prefWidth="105"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>

            <Label text="Selecciona una fila de la tabla para editar o eliminar sus datos."
                   styleClass="hint"/>
        </VBox>
    </HBox>

    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="8">
        <padding>
            <Insets top="8" right="22" bottom="8" left="22"/>
        </padding>
        <Label fx:id="lblEstado" text="Iniciando..." styleClass="status-text"/>
    </HBox>
</VBox>
